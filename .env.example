# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/botlace
MONGO_PASSWORD=botlace123

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key!!
HASH_SALT=botlace-salt-change-this

# AI Services
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Healthcare APIs
EPIC_CLIENT_ID=your-epic-client-id
EPIC_CLIENT_SECRET=your-epic-client-secret
EPIC_SANDBOX_URL=https://fhir.epic.com/interconnect-fhir-oauth

# GoHighLevel Integration
GHL_API_KEY=your-gohighlevel-api-key
GHL_LOCATION_ID=your-ghl-location-id

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# External Services
TEBRA_API_KEY=your-tebra-api-key
ICANOTES_API_KEY=your-icanotes-api-key
QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret

# Redis (for production)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# HIPAA Compliance
HIPAA_AUDIT_WEBHOOK=https://your-audit-endpoint.com
AUDIT_LOG_RETENTION_DAYS=2555