# Botlace Platform Environment Variables
# Copy this file to .env and fill in your actual values

# Database
DB_PASSWORD=your_secure_postgres_password
MONGO_PASSWORD=your_secure_mongo_password

# Authentication
JWT_SECRET=your_jwt_secret_min_32_chars_long
JWT_EXPIRATION=7d
REFRESH_TOKEN_EXPIRATION=30d

# External APIs

# GoHighLevel CRM
GHL_API_KEY=your_gohighlevel_api_key
GHL_API_URL=https://rest.gohighlevel.com/v1
GHL_WEBHOOK_SECRET=your_webhook_secret

# Stripe Payment
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# FHIR Integration
EPIC_CLIENT_ID=your_epic_client_id
EPIC_CLIENT_SECRET=your_epic_client_secret
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth

ICANOTES_API_KEY=your_icanotes_api_key
ICANOTES_BASE_URL=https://api.icanotes.com

TEBRA_API_KEY=your_tebra_api_key
TEBRA_BASE_URL=https://api.tebra.com

# AWS Configuration (for production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=botlace-data-lake

# Email & Communications
SENDGRID_API_KEY=your_sendgrid_api_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Monitoring & Analytics
DATADOG_API_KEY=your_datadog_api_key
SENTRY_DSN=your_sentry_dsn

# AI/ML Configuration
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment

# Feature Flags
ENABLE_AI_ASSISTANT=true
ENABLE_FEDERATED_LEARNING=false
ENABLE_PREDICTIVE_COMPLIANCE=true

# Environment
NODE_ENV=development
LOG_LEVEL=debug
